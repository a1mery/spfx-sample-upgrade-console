{
  "name": "spfx-sample-upgrade-console",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev --workspace @spfx-console/server\" \"npm:dev --workspace @spfx-console/web\"",
    "build": "npm run build --workspace @spfx-console/shared && npm run build --workspace @spfx-console/server && npm run build --workspace @spfx-console/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest --run",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,css,html}\" .prettierrc",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,css,html}\" .prettierrc"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
